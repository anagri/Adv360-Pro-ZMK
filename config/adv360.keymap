#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <250>;
            hold-trigger-on-release;
        };

        hm_shift: hm_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <150>;
        };

        mm_left: mm_left {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_LEFT";
            bindings = <&kp LEFT>, <&mmv MOVE_X(-300)>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        mm_right: mm_right {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RIGHT";
            bindings = <&hm RALT RIGHT>, <&mmv MOVE_X(300)>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        mm_up: mm_up {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_UP";
            bindings = <&hm RCTRL UP_ARROW>, <&mmv MOVE_Y(-300)>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        mm_down: mm_down {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_DOWN";
            bindings = <&hm_shift RIGHT_SHIFT DOWN_ARROW>, <&mmv MOVE_Y(300)>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        f9_vol_dn: f9_vol_dn {
            compatible = "zmk,behavior-mod-morph";
            label = "F9_VOL_DN";
            bindings = <&kp F9>, <&kp C_VOLUME_DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        f10_vol_up: f10_vol_up {
            compatible = "zmk,behavior-mod-morph";
            label = "F10_VOL_UP";
            bindings = <&kp F10>, <&kp C_VOLUME_UP>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        f8_vol_mute: f8_vol_mute {
            compatible = "zmk,behavior-mod-morph";
            label = "F8_VOL_MUTE";
            bindings = <&kp F8>, <&kp C_MUTE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        mm_right_click: mm_right_click {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RIGHT_CLICK";
            bindings = <&mkp RCLK>, <&kp PAGE_UP>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_left_click: mm_left_click {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_LEFT_CLICK";
            bindings = <&mkp LCLK>, <&kp PAGE_DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_del: mod_del {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bracket {
            bindings = <&kp GRAVE>;
            key-positions = <15 67>;
        };

        left_curly {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <67 17>;
        };

        right_curly {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <41 67 17>;
        };

        left_parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <67 18>;
        };

        right_parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <41 67 19>;
        };

        combo_pipe_slash {
            bindings = <&kp BACKSLASH>;
            key-positions = <67 24>;
        };

        combo_quotes {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <67 23>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&trans    &kp N1      &kp N2      &kp N3       &kp N4             &kp N5  &trans                                                       &mo 3              &kp N6  &kp N7             &kp N8       &kp N9      &kp N0         &trans
&trans    &kp Q       &kp W       &kp E        &kp R              &kp T   &kp LEFT_BRACKET                                             &kp RIGHT_BRACKET  &kp Y   &kp U              &kp I        &kp O       &kp P          &trans
&kp CAPS  &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm_shift LSHFT F  &kp G   &kp MINUS         &trans    &trans       &trans  &trans      &kp EQUAL          &kp H   &hm_shift RSHFT J  &hm RCTRL K  &hm RALT L  &hm RGUI SEMI  &kp SINGLE_QUOTE
&trans    &kp Z       &kp X       &kp C        &kp V              &kp B                               &trans       &trans                                 &kp N   &kp M              &kp COMMA    &kp DOT     &kp FSLH       &trans
&trans    &trans      &kp LCTRL   &kp LALT     &kp LGUI                   &kp SPACE         &mod_del  &kp TAB      &mo 1   &kp ESCAPE  &kp ENTER                  &trans             &trans       &trans      &trans         &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&trans  &trans             &trans        &trans        &trans              &trans        &trans                                      &trans    &trans    &trans          &trans           &trans      &trans            &trans
&trans  &kp F1             &kp F2        &kp F3        &kp F4              &kp F5        &trans                                      &kp C_PP  &kp F6    &kp F7          &f8_vol_mute     &f9_vol_dn  &f10_vol_up       &kp F11
&trans  &hm LGUI NUMBER_1  &hm LALT N2   &hm LCTRL N3  &hm_shift LSHFT N4  &kp NUMBER_5  &gresc  &trans  &trans      &trans  &trans  &kp HOME  &mm_left  &mm_down        &mm_up           &mm_right   &hm LEFT_GUI END  &kp F12
&trans  &kp NUMBER_6       &kp NUMBER_7  &kp N8        &kp NUMBER_9        &kp NUMBER_0                  &trans      &trans                    &trans    &mm_left_click  &mm_right_click  &trans      &trans            &trans
&trans  &trans             &trans        &trans        &trans                            &trans  &trans  &trans      &trans  &trans  &trans              &trans          &trans           &trans      &trans            &trans
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 0      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 1      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 1
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
